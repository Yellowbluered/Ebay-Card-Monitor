# ============================================================
# eBay 卡牌比價與撿漏機器人 — 環境變數範例
# 複製本檔為 .env 並填入實際值：cp .env.example .env
# ============================================================

# ---- Discord（必要） ---------------------------------------
DISCORD_TOKEN=your_discord_bot_token
# 推播頻道 ID（可逗號分隔多個）
DISCORD_CHANNEL_ID=123456789012345678,987654321098765432

# ---- 主動監控（模組 A 功能1） -------------------------------
# 每幾小時輪詢一次新上架的一口價商品（預設 2 小時）
POLL_INTERVAL_HOURS=2
# 要監控的關鍵字（逗號分隔），例如：
WATCH_KEYWORDS=2024 topps chrome sinner psa 10,charizard base set psa 10

# ---- 撿漏門檻（模組 E） ------------------------------------
# 現價（含運費）<= 歷史中位價 * 此門檻 即視為甜甜價（預設 0.7 = 7 折）
DISCOUNT_THRESHOLD=0.7
# 至少要有幾筆嚴格吻合的成交紀錄才計算基準價（預設 3）
MIN_SOLD_SAMPLES=3
# IQR 離群值倍數（預設 1.5）
IQR_K=1.5

# ---- SQLite 快取（模組 B） ---------------------------------
# 快取有效天數（預設 7 天）
CACHE_TTL_DAYS=7
# 資料庫檔路徑（留空 = 使用 python/ 目錄下的 card_cache.db）
DB_PATH=

# ---- eBay Browse API（模組 A，主動監控與手動查價的「在售」來源）----
EBAY_CLIENT_ID=your_ebay_app_id
EBAY_CLIENT_SECRET=your_ebay_cert_id
# production 或 sandbox
EBAY_ENV=production
# 市場 ID，預設 EBAY_US
EBAY_MARKETPLACE=EBAY_US

# ---- 成交價爬蟲（模組 C）-----------------------------------
# 後端：playwright（預設，無頭 Chromium 渲染繞過 403/登入牆）、
#       curl_cffi（TLS 指紋模擬）、requests（純 HTTP）、external（外部 Scraper API）
SCRAPER_BACKEND=playwright
# Playwright 是否無頭（1=無頭；0=開視窗除錯）
SCRAPER_HEADLESS=1
# 使用本機已安裝的瀏覽器（chrome / msedge），留空則用 Playwright 自帶 Chromium
SCRAPER_BROWSER_CHANNEL=
# curl_cffi 後端要模擬的瀏覽器版本（僅 SCRAPER_BACKEND=curl_cffi 時生效）
SCRAPER_IMPERSONATE=chrome124
# 外部 Scraper 介面（SCRAPER_BACKEND=external 時使用）
EXTERNAL_SCRAPER_URL=
# 外部 Scraper 雙 API（SCRAPER_BACKEND=external 時，兩家輪替 + 容錯切換）
SCRAPINGDOG_API_KEY=
SERPAPI_API_KEY=
# Proxy（http://user:pass@host:port），搭配 SCRAPER_USE_PROXY=1 啟用
SCRAPER_PROXY_URL=
SCRAPER_USE_PROXY=0
# 連續請求隨機延遲區間（秒），預設 2 ~ 4 秒
SCRAPER_DELAY_MIN=2
SCRAPER_DELAY_MAX=4
# 成交頁要抓幾頁（預設 1）
SCRAPER_PAGES=1

# ---- DeepSeek 結構化解析（模組 D，選填）--------------------
# 留空 = 純正則解析；填入 key 後會優先嘗試 DeepSeek JSON 解析
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
