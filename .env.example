# ============================================================
# eBay Browse API 憑證（主方案）
# 申請步驟請見 README.md「如何申請 eBay Client ID / Secret」
# 複製本檔為 .env 後填入自己的值。
# ============================================================

# Application Keyset 的 App ID (Client ID)
EBAY_CLIENT_ID=

# Application Keyset 的 Cert ID (Client Secret)
EBAY_CLIENT_SECRET=

# production（正式環境，真實商品）或 sandbox（測試環境，假資料）
EBAY_ENV=production

# 預設市場：EBAY_US / EBAY_GB / EBAY_DE / EBAY_AU / EBAY_HK / EBAY_CA
EBAY_MARKETPLACE=EBAY_US

# 預設幣別（建議留空 = 自動採用結果中佔多數的幣別，可自由切換市場）
# 注意：若寫死 USD 又切換到其他市場（例如 EBAY_HK 是 HKD），會被幣別過濾成 0 筆。
EBAY_CURRENCY=

# ============================================================
# 備用方案（Puppeteer 爬蟲）設定
# ============================================================

# headless=true 不顯示瀏覽器視窗；被 Akamai 擋時可設 false 觀察
SCRAPER_HEADLESS=true

# 已有本機 Chrome 時可填 chrome，避免下載 Chromium（例：chrome）
SCRAPER_CHANNEL=

# 每次翻頁間隔（毫秒），避免請求過快觸發反爬
SCRAPER_DELAY_MS=1500

# ============================================================
# 成交價基準（--sold-ref）設定（選填）
# ============================================================

# 預設抓幾頁「已售出」當基準（例：2）
SOLD_PAGES=2

# 在售價 vs 成交中位數的 貴/合理/抵買 門檻百分比（例：15）
SOLD_VS_PCT=15

# ============================================================
# Discord Bot（甜甜價推播 + 雙向指令）
# ============================================================

# Discord Application 的 Client ID（等同 Application ID / Bot ID，用於產生 OAuth2 邀請連結）
CLIENT_ID=

# 從 Discord Developer Portal 建立的 Bot Token（需開啟 Message Content Intent）
DISCORD_TOKEN=

# 要推播甜甜價的頻道 ID（可逗號分隔多個；Discord 開發者模式 → 頻道右鍵 → 複製頻道 ID）
DISCORD_CHANNEL_ID=

# 背景輪詢間隔（分鐘），預設 120（2 小時）
DISCORD_POLL_INTERVAL_MIN=120

# 甜甜價門檻：低於歷史平均價的百分比，預設 0 = 只要低於平均就推播
DISCORD_MIN_DISCOUNT=0
